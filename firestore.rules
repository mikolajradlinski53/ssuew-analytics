rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Firestore nie widzi zmiennych srodowiskowych Vercela, wiec liste dostepu
    // trzeba powtorzyc tutaj. Sprawdzamy adres e-mail wprost z tokenu — Firebase
    // wklada go tam przy logowaniu, wiec nie potrzeba zadnych wlasnych oswiadczen
    // (custom claims) ani Admin SDK.
    //
    // UWAGA: te dwa adresy musza byc takie same jak DECK_OWNER_EMAIL
    // i DECK_BOARD_EMAILS w konfiguracji Vercela. Zmieniasz w jednym miejscu —
    // zmien i w drugim, bo inaczej ktos bedzie widzial przyciski edycji, ktore
    // baza i tak odrzuci.
    function wlasciciel() {
      return 'kontakt@samorzad.ue.wroc.pl';
    }

    function zarzad() {
      return ['mikolaj.radlinski@samorzad.ue.wroc.pl'];
    }

    function jestWlascicielem() {
      return request.auth != null && request.auth.token.email == wlasciciel();
    }

    function maDostep() {
      return request.auth != null
        && (request.auth.token.email == wlasciciel() || request.auth.token.email in zarzad());
    }

    match /semestry/{semestrId} {
      allow read: if maDostep();
      allow write: if jestWlascicielem();

      match /wydarzenia/{wydarzenieId} {
        allow read: if maDostep();
        allow write: if jestWlascicielem();
      }

      // Skrzynke widzi i oproznia wylacznie wlasciciel — dla zarzadu liczba
      // nierozpatrzonych propozycji nic nie znaczy. Zarzad DOPISUJE propozycje
      // przez /api/planer, ktore uzywa Admin SDK i reguly omija.
      match /propozycje/{propozycjaId} {
        allow read, write: if jestWlascicielem();
      }

      // Rozmowa jest wspolna: czytaja wszyscy z dostepem. Wlasciciel pisze
      // wprost, zarzad przez serwer.
      match /komentarze/{komentarzId} {
        allow read: if maDostep();
        allow write: if jestWlascicielem();
      }

      match /obecnosc/{uid} {
        allow read: if maDostep();
        allow write: if jestWlascicielem();
      }
    }

    // Orbita: prywatna tablica zadan. Dostep ma wylacznie wlasciciel dokumentu,
    // rozpoznawany po identyfikatorze konta Firebase.
    match /users/{uid}/{dokument=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Wszystko, czego nie wymieniono wyzej, jest zamkniete. Regula musi byc
    // ostatnia, bo Firestore stosuje sume uprawnien, nie pierwsze dopasowanie.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
