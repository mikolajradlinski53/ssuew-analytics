# Skopiuj do .env.local i uzupełnij. .env.local nie trafia do repozytorium.

# ─── Firebase — Authentication, dostawca „E-mail/hasło" ─────────────
# Klucze publiczne z założenia: Firebase wysyła je do przeglądarki.
# Chroni Cię lista autoryzowanych domen w konsoli Firebase oraz lista
# adresów poniżej, a nie tajność tych wartości.
# Konta zakładasz ręcznie w konsoli — rejestracja własna jest wyłączona.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ─── Konta z hasłem ─────────────────────────────────────────────────
# Dwa adresy, które wchodzą e-mailem i hasłem. Owner zapisuje wszędzie
# i jako jedyny widzi Orbitę; board czyta Analytics i pracuje w Plannerze.
# Reszta zarządu wchodzi kodem z zakładki `kody` — kod zawsze daje board.
DECK_OWNER_EMAIL=
DECK_BOARD_EMAILS=

# ─── Sekret podpisujący sesje kodowe ────────────────────────────────
# Minimum 32 znaki. Bez niego bilet wstępu dałoby się wypisać samodzielnie,
# więc aplikacja woli głośno odmówić niż po cichu wpuścić kogokolwiek.
# Wygeneruj: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
DECK_SESSION_SECRET=

# ─── Arkusz Google przez Apps Script ────────────────────────────────
# Instrukcja: apps-script/README.md (sześć kroków).
# Sekrety wyłącznie serwerowe — bez NEXT_PUBLIC_, bo trasy /api/* mają je
# chronić przed przeglądarką. Bez nich Analytics działa na danych
# demonstracyjnych zaszytych w lib/useAnalyticsData.ts.
GAS_URL=
GAS_TOKEN=

# ─── Klucz konta serwisowego Firebase ───────────────────────────────
# Cały JSON w jednej linii. Potrzebny wyłącznie po to, żeby osoby wchodzące
# kodem mogły czytać Planer — nie mają konta Firebase, więc reguły Firestore
# ich nie wpuszczą. Konsola Firebase → Project settings → Service accounts
# → Generate new private key.
FIREBASE_SERVICE_ACCOUNT=
