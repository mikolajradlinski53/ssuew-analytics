# Skopiuj do .env.local i uzupełnij. .env.local nie trafia do repozytorium.

# ─── Firebase — Authentication z dostawcą Google ────────────────────
# Klucze publiczne z założenia: Firebase wysyła je do przeglądarki.
# Chroni Cię lista autoryzowanych domen w konsoli Firebase oraz lista
# adresów poniżej, a nie tajność tych wartości.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ─── Lista dostępu ──────────────────────────────────────────────────
# Adresy KONT GOOGLE, nie te używane na co dzień. Owner zapisuje wszędzie;
# board czyta Analytics i pracuje w Plannerze, ale nie widzi Orbity.
# Nie wiesz, którym kontem się logujesz? Zaloguj się raz — strona logowania
# poda odrzucony adres, wystarczy go wkleić i zrestartować serwer.
DECK_OWNER_EMAIL=
DECK_BOARD_EMAILS=

# ─── Arkusz Google przez Apps Script ────────────────────────────────
# Instrukcja: apps-script/README.md (sześć kroków).
# Sekrety wyłącznie serwerowe — bez NEXT_PUBLIC_, bo trasy /api/* mają je
# chronić przed przeglądarką. Bez nich Analytics działa na danych
# demonstracyjnych zaszytych w lib/useAnalyticsData.ts.
GAS_URL=
GAS_TOKEN=
